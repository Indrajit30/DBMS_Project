{
  "name": "multiwarehouse-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/status.ts",
    "db:seed": "tsx src/db/seed-local.ts",
